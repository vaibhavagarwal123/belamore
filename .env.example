# ---- Database ----
# Local dev uses SQLite (zero setup). For production, point this at a hosted
# Postgres database and switch the provider in prisma/schema.prisma to
# "postgresql" (see SETUP.md).
DATABASE_URL="file:./dev.db"

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Long random string used to sign admin/customer session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="replace-this-with-a-long-random-string"

# ---- Payments ----
# Razorpay (India, supports UPI/cards/netbanking/wallets)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (international cards + can enable PayPal via Stripe or a dedicated PayPal integration)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Email (used for admin password reset + contact form + order emails) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Belamore <hello@belamoregifts.com>"

# ---- Marketing / analytics (optional, safe to leave blank) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_TAWKTO_WIDGET_ID=""
MAILCHIMP_API_KEY=""
MAILCHIMP_SERVER_PREFIX=""
MAILCHIMP_AUDIENCE_ID=""
